# Copie para `.env` e preencha. NUNCA versione o `.env` (P-007).

# --- Banco de dados ---
# Desenvolvimento: o docker-compose.yml deste repositório.
# Produção: a connection string do POOLER do Neon (não a direta) — ver README.md.
DATABASE_URL="postgresql://connectgsa:connectgsa_dev@localhost:5433/connectgsa"

# Banco da suíte de testes. PRECISA ser diferente do de cima: os testes limpam
# tabelas inteiras, e apontá-los para o banco de desenvolvimento apagaria os
# dados que você semeou. O código se recusa a rodar se os dois forem iguais.
TEST_DATABASE_URL="postgresql://connectgsa:connectgsa_dev@localhost:5433/connectgsa_test"

# --- API ---
NODE_ENV="development"
PORT="3333"
# Origens permitidas no CORS, separadas por vírgula. Sem curinga.
WEB_ORIGINS="http://localhost:5173"
# URL pública do SPA, usada nos redirecionamentos de OAuth e nas prévias de link.
WEB_URL="http://localhost:5173"
API_URL="http://localhost:3333"

# --- Better Auth ---
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# --- Provedores OAuth (crie as credenciais em cada console) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
