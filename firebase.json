{
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["**/.*", "**/node_modules/**", "**/*.map"],
    "rewrites": [
      {
        "//": "Só o que NÃO é arquivo vai para o index.html. Sem a exclusão, um asset ausente responde HTML com status 200 — e o navegador tenta executá-lo como script. Foi assim que um worker faltante deixou o mapa cinza, sem erro nenhum.",
        "source": "!/assets/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), camera=(), microphone=(), interest-cohort=()"
          }
        ]
      }
    ]
  }
}
