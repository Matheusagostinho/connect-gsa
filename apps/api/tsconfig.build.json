{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/testing/**"
  ],
  "references": [
    {
      "path": "../../packages/shared/tsconfig.build.json"
    },
    {
      "path": "../../packages/db/tsconfig.build.json"
    }
  ]
}
