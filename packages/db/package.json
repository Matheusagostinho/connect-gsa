{
  "name": "@connect-gsa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema Prisma e client do Postgres \u2014 fonte de verdade dos dados persistentes",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.4"
  },
  "devDependencies": {
    "@connect-gsa/config": "workspace:*",
    "eslint": "^10.8.1",
    "prisma": "^7.9.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
