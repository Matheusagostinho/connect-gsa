// Schema do ConnectGSA.
//
// Convenção de nomes: os modelos `User`, `Session`, `Account` e `Verification`
// seguem o schema canônico do Better Auth — os nomes de campo são exigidos pela
// biblioteca e não podem ser traduzidos. Os campos e modelos próprios do
// ConnectGSA seguem a mesma convenção (inglês) para o schema ficar coerente.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

// A URL de conexão vive em `prisma.config.ts` (Prisma 7 removeu `url` daqui) e
// chega ao client em runtime pelo driver adapter — ver `src/client.ts`.
datasource db {
  provider = "postgresql"
}

enum Role {
  ambassador
  moderator
  admin
}

/// Um participante da rede.
///
/// ATENÇÃO (P-001): não existe, e não deve passar a existir, coluna de latitude
/// ou longitude aqui. A posição de um embaixador no mapa é o centroide da
/// `City` que ele escolheu. Guardar coordenada precisa do aparelho transformaria
/// um vazamento de banco em um vazamento de paradeiro de estudantes.
model User {
  // --- Campos exigidos pelo Better Auth ---
  id            String   @id @default(uuid())
  name          String
  /// P-002: nunca sai da API. A serialização de perfil passa obrigatoriamente
  /// pelo `toPublicProfile`, que não conhece este campo.
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- Campos do ConnectGSA ---
  role           Role     @default(ambassador)
  course         String?
  bio            String   @default("")
  /// Lista de `{ label, url }` validada pelo `linkSchema` de @connect-gsa/shared.
  links          Json     @default("[]")

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  cityId        String?
  city          City?        @relation(fields: [cityId], references: [id], onDelete: SetNull)

  /// Endereço público do perfil (`/perfil/ana-ribeiro`).
  ///
  /// Derivado do nome no primeiro salvamento. A pessoa PODE trocá-lo, mas com
  /// duas defesas, porque endereço compartilhado que deixa de funcionar é pior
  /// que slug desatualizado (ASM-016): o anterior fica guardado e continua
  /// respondendo, e há intervalo mínimo entre trocas.
  slug String? @unique

  /// O endereço anterior, que continua encontrando este perfil.
  ///
  /// Guardamos apenas UM: uma cadeia de todos os endereços já usados custa uma
  /// tabela para um caso raro. `@unique` porque ele também precisa impedir que
  /// outra pessoa tome o endereço enquanto ele ainda responde.
  previousSlug String? @unique

  /// Quando o nome de usuário foi trocado pela última vez.
  slugChangedAt DateTime?

  /// Quem trouxe esta pessoa para a rede.
  ///
  /// A indicação mora em quem foi INDICADO, não no convite. Um convite é um
  /// papel que se consome e pode desaparecer com quem o emitiu — a indicação é
  /// um fato permanente, e vai alimentar a gamificação.
  ///
  /// `SetNull` e NUNCA `Cascade`: com cascade, excluir um embaixador apagaria em
  /// silêncio todo mundo que ele convidou. É o tipo de erro que só aparece no
  /// dia em que alguém sai do programa, e aí já apagou.
  invitedById String?
  invitedBy   User?   @relation("Indicacao", fields: [invitedById], references: [id], onDelete: SetNull)
  invited     User[]  @relation("Indicacao")

  /// Até quando esta pessoa já viu as próprias notificações.
  ///
  /// Uma coluna em vez de uma tabela de notificações. Nesta escala, manter
  /// registros duplicados de algo que já está no banco — pedidos, reações,
  /// comentários — custa mais do que consultá-los, e cria a chance de os dois
  /// lados divergirem (ASM-019).
  notificationsSeenAt DateTime?

  /// AC-015 / P-011: aparecer no mapa é escolha ativa. O default é, e precisa
  /// continuar sendo, `false`.
  /// Perfil novo NASCE no mapa (P-011, invertido em 2026-08-19).
  ///
  /// O padrão mudou de `false` para `true`. Quem já tinha perfil não foi
  /// migrado: ligar o mapa de quem escolheu ficar fora seria desfazer a decisão
  /// dessa pessoa pelas costas.
  visibleOnMap   Boolean @default(true)
  profileComplete Boolean @default(false)

  sessions       Session[]
  accounts       Account[]
  invitesCreated InviteCode[] @relation("InviteCreator")

  /// Aparelhos inscritos para receber aviso por notificação.
  pushSubscriptions PushSubscription[]

  /// Por qual convite esta pessoa entrou.
  ///
  /// Mora aqui, e não em `InviteCode.usedById`, porque o convite deixou de ser
  /// de uso único: um link atende quantas pessoas o receberem, então o lado
  /// "muitos" é o do usuário. `SetNull` porque perder o convite não pode
  /// apagar quem entrou por ele — quem trouxe a pessoa é `invitedById`, que é
  /// um registro separado e permanente.
  invitedViaId String?
  invitedVia   InviteCode? @relation("InviteConsumer", fields: [invitedViaId], references: [id], onDelete: SetNull)
  posts          Post[]
  reactions      PostReaction[]
  comments       Comment[]
  /// Catálogo fechado — ver o modelo `Skill`.
  skills         Skill[]
  institutionsProposed Institution[] @relation("InstitutionProposer")
  connectionsAsA Connection[]  @relation("ConnectionA")
  connectionsAsB Connection[]  @relation("ConnectionB")
  connectionsRequested Connection[] @relation("ConnectionRequester")

  @@index([institutionId])
  @@index([cityId])
  // Filtro do diretório e do mapa: só perfis completos e visíveis interessam.
  @@index([visibleOnMap, profileComplete])
  // "Quantas pessoas fulano trouxe" será consulta de gamificação, não de tela solta.
  @@index([invitedById])
  // "Quantas pessoas entraram por este link" é lido na tela de convites.
  @@index([invitedViaId])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Vínculo entre a conta do ConnectGSA e a do provedor social.
///
/// **`issuer` é exigido pelo Better Auth 1.7** — ele consulta esta tabela por
/// `[issuer, accountId]` em `findAccountOwnerByKey`, no retorno do OAuth. Sem a
/// coluna, o Prisma recusa a consulta e o login inteiro morre com
/// `internal_server_error`, sem dizer qual campo falta.
///
/// Isso não aparecia em teste: o `testUtils` grava pelo `internalAdapter` sem
/// passar pelo caminho de vínculo de conta do OAuth, que é onde `issuer` é lido.
/// Só apareceu no primeiro login real com o Google.
///
/// `providerId` continua existindo — os dois convivem no schema do 1.7. O que
/// mudou de lugar foi o índice ÚNICO: era `[providerId, accountId]`, agora é
/// `[issuer, accountId]`.
model Account {
  id                    String    @id @default(uuid())
  accountId             String
  /// Quem emitiu a identidade, no formato de URL (`https://accounts.google.com`).
  issuer                String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // O Better Auth 1.7 busca por [issuer, accountId]; é este par que precisa ser
  // único. O antigo [providerId, accountId] saiu junto.
  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Convite para entrar na rede (US-002).
///
/// O código em claro NUNCA é persistido: guardamos o SHA-256 dele (P-009). Um
/// dump do banco, portanto, não entrega nenhum convite utilizável.
///
/// **Era de uso único até 2026-08-20.** `usedById` era `@unique`, e era o banco
/// quem recusava o segundo uso. Passou a valer para quantas pessoas receberem o
/// link, até expirar — decisão do dono do produto, registrada no P-009 com o
/// custo que ela tem. O que segura o portão agora é só o PRAZO, e é por isso que
/// ele encurtou de 30 para 15 dias.
model InviteCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  note      String?
  expiresAt DateTime

  /// A última vez que alguém entrou por este convite.
  ///
  /// Chamava-se `usedAt` e queria dizer "consumido em". Num convite que atende
  /// várias pessoas esse nome mente: ele sugere que o convite acabou ali.
  lastUsedAt DateTime?

  createdById String
  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  /// Todo mundo que entrou por este convite. Era `usedBy User?`, um só.
  usedBy User[] @relation("InviteConsumer")

  createdAt DateTime @default(now())

  @@index([createdById])
  @@index([expiresAt])
}

/// Um aparelho inscrito para receber aviso por notificação.
///
/// A NOTIFICAÇÃO continua derivada do que já está no banco (ASM-019) — esta
/// tabela não a duplica. O que ela guarda é o APARELHO: coisas com vidas
/// diferentes, porque a notificação é calculada e o aparelho é um registro que
/// nasce quando alguém autoriza e morre quando desinstala.
///
/// `endpoint` é a chave única porque é ele que o navegador garante ser único por
/// aparelho e por origem. Usar `userId` não serviria: a mesma pessoa se inscreve
/// no celular e no computador, e são duas entregas.
///
/// `onDelete: Cascade`: excluir a conta precisa levar as inscrições junto, senão
/// o aparelho continuaria recebendo aviso de uma rede da qual a pessoa saiu.
model PushSubscription {
  id       String @id @default(uuid())
  endpoint String @unique
  /// Chaves de criptografia do navegador. Sem elas o envio não é decifrável.
  p256dh   String
  auth     String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Lista de e-mails pré-aprovados pelo programa (Q-001).
///
/// Caminho alternativo ao convite: se o programa entregar a relação oficial de
/// embaixadores, o primeiro login desses e-mails dispensa código.
/// Lista de e-mails pré-aprovados pelo programa (Q-001).
///
/// O e-mail é guardado SEMPRE em minúsculas, e há uma `CHECK` no banco
/// garantindo isso — ver a migração `20260821090000_allowed_email_minusculo`.
///
/// O motivo é uma falha silenciosa que aconteceu no primeiro acesso em
/// produção: `isEmailAllowed` normaliza o e-mail que CHEGA do provedor, mas nada
/// normalizava o que estava gravado. Uma linha com maiúscula nunca casa com
/// ninguém, e a pessoa é recusada no portão sem nenhuma pista do porquê.
model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())
}

enum InstitutionStatus {
  /// Curada por nós ou aprovada pela coordenação — aparece para todo mundo.
  approved
  /// Proposta por um embaixador; só quem propôs a enxerga até ser aprovada.
  pending
}

/// Uma instituição de ensino — no nível do CAMPUS, não da reitoria.
///
/// Um registro por campus (ASM-013). Quem estuda no IFNMG em Pirapora procura
/// "IFNMG Pirapora" de uma vez, não uma instituição e depois um campus numa
/// segunda lista.
///
/// `status` existe porque nenhuma lista de instituições do Brasil fica completa:
/// perseguir o dataset perfeito é trabalho sem fim, deixar propor é o conserto
/// durável (ASM-014).
model Institution {
  id      String  @id @default(uuid())
  name    String
  /// Nome do campus, quando a instituição tem mais de um. Vazio quando não há.
  ///
  /// String vazia em vez de `null` de propósito: no Postgres, NULLs são
  /// distintos entre si num índice único, então `@@unique([name, campus])` com
  /// campus nulo NÃO impediria duplicatas — que é justamente o que ele existe
  /// para impedir.
  campus  String  @default("")
  acronym String?

  status       InstitutionStatus @default(approved)
  proposedById String?
  proposedBy   User?             @relation("InstitutionProposer", fields: [proposedById], references: [id], onDelete: SetNull)

  users User[]

  createdAt DateTime @default(now())

  @@unique([name, campus])
  @@index([status, name])
  @@index([acronym])
  @@index([proposedById])
}

/// Catálogo fechado de habilidades.
///
/// Texto livre parecia mais flexível e destruía a busca: "React", "react" e
/// "ReactJS" nunca se cruzavam, então filtrar por habilidade não encontrava
/// ninguém (ASM-015). O `slug` é a identidade estável; o `name` é só rótulo.
model Skill {
  id       String @id @default(uuid())
  slug     String @unique
  name     String
  category String

  users User[]

  @@index([category, name])
}

/// O laço entre dois embaixadores.
///
/// Guardado com `userAId` < `userBId` SEMPRE, o que torna o índice único uma
/// garantia de que não existem dois registros opostos para o mesmo par
/// (AC-057). Sem essa normalização, A→B e B→A seriam duas linhas distintas e o
/// banco não teria como recusar a segunda.
///
/// `requestedById` guarda quem pediu, que a ordenação canônica apaga — e é do
/// que a outra pessoa precisa para saber que tem um pedido a responder.
model Connection {
  id     String           @id @default(uuid())
  status ConnectionStatus @default(pending)

  userAId String
  userA   User   @relation("ConnectionA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String
  userB   User   @relation("ConnectionB", fields: [userBId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("ConnectionRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
}

enum ConnectionStatus {
  pending
  accepted
}

/// Município brasileiro (ASM-001/ASM-005), com o centroide oficial do IBGE.
///
/// Este centroide é a granularidade máxima de localização que o ConnectGSA
/// conhece sobre qualquer pessoa (P-001).
model City {
  id        String @id @default(uuid())
  ibgeCode  String @unique
  name      String
  state     String @db.Char(2)
  latitude  Float
  longitude Float
  users     User[]

  @@unique([name, state])
  @@index([state, name])
}

enum PostKind {
  /// Publicação comum de um embaixador.
  feed
  /// Comunicado oficial do programa — só a coordenação publica.
  announcement
}

/// As reações do ConnectGSA. Os nomes espelham `REACTIONS` de @connect-gsa/shared.
enum ReactionKind {
  /// "Decolou" — a principal.
  liftoff
  /// "Aprendi"
  learned
  /// "Respeito"
  respect
  /// "Bora junto" — sinaliza intenção de colaborar.
  together
  /// "Posso ajudar" — sinaliza oferta de ajuda.
  offerHelp
}

model Post {
  id       String   @id @default(uuid())
  kind     PostKind @default(feed)
  content  String
  /// Chave do objeto no armazenamento. A URL é montada na saída, nunca guardada:
  /// trocar de provedor não deveria exigir reescrever linhas do banco.
  mediaKey String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// Contadores desnormalizados: o feed ordena por engajamento, e um COUNT(*)
  /// por post a cada página seria uma consulta por linha exibida.
  reactionCount Int @default(0)
  commentCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions PostReaction[]
  comments  Comment[]

  /// Paginação por cursor: `id` desempata posts do mesmo instante.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
  @@index([kind, createdAt(sort: Desc)])
}

/// A reação de uma pessoa a um post.
///
/// `@@unique([postId, userId])` é o que torna "uma reação por pessoa, trocável"
/// (ASM-008) uma garantia do BANCO. Sem isso, dois toques rápidos no celular
/// criariam duas reações e a contagem passaria a mentir.
model PostReaction {
  id     String       @id @default(uuid())
  kind   ReactionKind
  postId String
  post   Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId, kind])
  @@index([userId])
}

model Comment {
  id      String @id @default(uuid())
  content String

  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}
